// # ooguard Main Entry Point
//
// Logline: Prompt injection and destructive command guardrail filtering agent tool arguments.
//
// Setup: Demands explicit capability tokens and standard argument list.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, --test, or --mcp.
//   2. List active security rule signatures or execute input sanitization.
//   3. Inspect target command or prompt payload against selected security policy.
//   4. Format and stream terminal report badges or structured JSON telemetry.

import "core/guard_types.oo";
import "core/rules_catalog.oo";
import "core/inspection_engine.oo";
import "core/sanitizer.oo";
import "render/render_report.oo";
import "render/render_json.oo";
import "render/render_demo.oo";
import "ipc/cli_options.oo";
import "ipc/mcp_server.oo";
import "anchor.oo";

fn run_all_tests() -> Bool {
    return verify_root_subsystem();
}

pub fn main(
    fr: &FsReadCap,
    _pr: &ProcessCap,
    _env: &EnvCap,
    args: List[String]
) -> Int {
    let opts: CliOptions = parse_cli_options(args);

    if opts.show_help {
        print(render_cli_help());
        return 0;
    }
    if opts.show_version {
        print(render_cli_version());
        return 0;
    }
    if opts.run_test {
        if run_all_tests() {
            print("ooguard: internal anchor tests PASSED\n");
            return 0;
        } else {
            print("ooguard: internal anchor tests FAILED\n");
            return 1;
        }
    }
    if opts.show_mcp {
        return run_mcp_server(fr);
    }
    if opts.show_demo {
        print(render_guard_demo(opts.use_color));
        return 0;
    }
    if opts.show_rules {
        let rules: List[SecurityRule] = get_standard_security_rules();
        if opts.json_output {
            print(rules_to_json(rules) + "\n");
        } else {
            print(render_rules_list(rules, opts.use_color));
        }
        return 0;
    }

    if opts.do_sanitize {
        if chars_len(opts.target_text) == 0 {
            print("ooguard: missing input text to sanitize\n");
            return 2;
        }
        let sanitized: String = sanitize_text(opts.target_text);
        print(sanitized + "\n");
        return 0;
    }

    if chars_len(opts.target_text) == 0 {
        print("ooguard: missing input text or command to inspect (try --help)\n");
        return 2;
    }

    let pol: GuardPolicy = resolve_policy_by_name(opts.policy_name);
    let res: InspectionResult = inspect_input(opts.target_text, pol);

    if opts.json_output {
        print(inspection_to_json(res) + "\n");
    } else {
        print(render_inspection_report(res, opts.use_color));
    }

    if res.allowed {
        return 0;
    } else {
        return 1;
    }
}
