// # Command-Line Options Parser
//
// Logline: Decodes CLI flags, security policies, inspection modes, and targets for ooguard.
//
// Setup: Pure argument tokenizer supporting inspection, sanitization, JSON, and MCP modes.
//
// Beats:
//   1. Declare structured CliOptions configuration type.
//   2. Parse help, version, policy selection, and sanitization switches.
//   3. Parse JSON telemetry, rule inventory, and demo showcase controls.
//   4. Concatenate positional command and prompt tokens into target payload string.

pub type CliOptions = struct {
    show_help: Bool,
    show_version: Bool,
    show_mcp: Bool,
    show_demo: Bool,
    show_rules: Bool,
    do_sanitize: Bool,
    json_output: Bool,
    use_color: Bool,
    run_test: Bool,
    policy_name: String,
    target_text: String
};

pub fn render_cli_help() -> String {
    return "ooguard 0.2.0 (openOODA sovereign agent tool guardrail & security firewall)\n"
        + "usage: ooguard [options] [<text_or_command>...]\n\n"
        + "Prompt injection and destructive command guardrail filtering agent tool arguments.\n\n"
        + "Options:\n"
        + "  -h, --help                 display this help and exit\n"
        + "  -v, --version              output version information and exit\n"
        + "  -p, --policy <NAME>        enforcement policy: strict, balanced, permissive [default: balanced]\n"
        + "  -s, --sanitize             redact dangerous patterns and secrets from input\n"
        + "      --rules                list all active security rules and attack signatures\n"
        + "  -j, --json                 output structured JSON metrics\n"
        + "  -D, --demo                 interactive multi-vector attack defense showcase\n"
        + "      --no-color             suppress ANSI color escape sequences\n"
        + "      --test                 execute internal multi-tier verification suite\n"
        + "      --mcp                  run as Model Context Protocol stdio server\n";
}

pub fn render_cli_version() -> String {
    return "ooguard 0.2.0 (openOODA sovereign userland)\n";
}

pub fn parse_cli_options(args: List[String]) -> CliOptions {
    let mut help_flag: Bool = false;
    let mut ver_flag: Bool = false;
    let mut mcp_flag: Bool = false;
    let mut demo_flag: Bool = false;
    let mut rules_flag: Bool = false;
    let mut san_flag: Bool = false;
    let mut json_flag: Bool = false;
    let mut color_flag: Bool = true;
    let mut test_flag: Bool = false;
    let mut pol_str: String = "balanced";
    let mut text_buf: String = "";

    let n: Int = list_len(args);
    let mut i: Int = 0;

    while i < n {
        let arg: String = list_get(args, i);
        if arg == "-h" || arg == "--help" {
            help_flag = true;
        } else if arg == "-v" || arg == "--version" {
            ver_flag = true;
        } else if arg == "--mcp" {
            mcp_flag = true;
        } else if arg == "-D" || arg == "--demo" {
            demo_flag = true;
        } else if arg == "--rules" {
            rules_flag = true;
        } else if arg == "-s" || arg == "--sanitize" {
            san_flag = true;
        } else if arg == "-j" || arg == "--json" {
            json_flag = true;
        } else if arg == "--no-color" {
            color_flag = false;
        } else if arg == "--test" {
            test_flag = true;
        } else if (arg == "-p" || arg == "--policy") && i + 1 < n {
            pol_str = list_get(args, i + 1);
            i = i + 1;
        } else if !str_starts_with(arg, "-") {
            if chars_len(text_buf) == 0 {
                text_buf = arg;
            } else {
                text_buf = text_buf + " " + arg;
            }
        }
        i = i + 1;
    }

    return CliOptions {
        show_help: help_flag,
        show_version: ver_flag,
        show_mcp: mcp_flag,
        show_demo: demo_flag,
        show_rules: rules_flag,
        do_sanitize: san_flag,
        json_output: json_flag,
        use_color: color_flag,
        run_test: test_flag,
        policy_name: pol_str,
        target_text: text_buf
    };
}
